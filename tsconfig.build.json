{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/__fixtures__/**",
    "src/**/*-fixtures.ts",
    "src/**/*-fixture.ts"
  ]
}
